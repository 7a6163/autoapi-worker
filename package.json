{
  "name": "autoapi-e5",
  "version": "1.0.0",
  "description": "E5 Auto Renewal on Cloudflare Workers",
  "main": "src/index.ts",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.test.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"src/**/*.test.ts\""
  },
  "dependencies": {
    "hono": "^4.6.3",
    "xlsx": "npm:@e965/xlsx@0.20.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.28.0"
  }
}
